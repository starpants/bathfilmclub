---
interface Props {
  /** Dim at rest, brighten on hover — matches the nav icons. Off by default (Hero CTA stays bright). */
  dim?: boolean;
}
const { dim = false } = Astro.props;
const DISCORD_URL = 'https://discord.gg/FXpgFuMGdP';
---

<!-- In the nav row `self-stretch` matches the height of the square icon buttons sitting
     beside it, which are taller than this button's own text + padding. -->
<a
  href={DISCORD_URL}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['btn-discord', dim && 'self-stretch opacity-50 hover:opacity-100']}
>
  Join on Discord<span class="sr-only"> (opens in a new tab)</span>
  <!-- External-link mark. Same path as FilmPanel.tsx's trailer link — inlined in both
       because that one is React and can't import an Astro component. -->
  <svg
    width="16"
    height="16"
    viewBox="0 0 32 32"
    fill="currentColor"
    class="shrink-0 md:w-5 md:h-5"
    aria-hidden="true"
  >
    <path d="M18 5v2h5.563L11.28 19.281l1.438 1.438L25 8.437V14h2V5ZM5 9v18h18V14l-2 2v9H7V11h9l2-2Z"
    ></path>
  </svg>
</a>
