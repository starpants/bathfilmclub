---
import TmdbLogo from './TmdbLogo.astro';
// import NavBar from './NavBar.astro';
// import { getAllThemes } from '../utils/data';

interface Props {
  /** Explicit `undefined` allowed: Layout always forwards its own optional prop. */
  bg?: string | undefined;
}

const { bg = 'bg-bfc-brand-alt/10' } = Astro.props;
const year = new Date().getFullYear();
// const allThemes = await getAllThemes();
---

<footer class:list={['py-12', bg]}>
  <div
    class="grid grid-cols-1 md:grid-cols-2 items-start justify-center gap-3 pb-4 max-w-60 md:max-w-lg mx-auto"
  >
    <div class="text-center capitalize mx-auto">
      <p class="font-body text-bfc-brand-fg/60 text-sm">
        &copy; {year} Bath Film Club. All rights reserved.
      </p>
      <p class="font-body text-bfc-brand-fg/60 text-sm md:mb-4">
        Website Designed And Built by
        <div>
          <a
            href="https://meafabula.co.uk"
            class="text-bfc-brand-accent hover:text-bfc-brand-fg transition-colors duration-300"
            >Mea Fabula Studio</a
          >
        </div>
      </p>
    </div>
    <div class="text-center">
      <p class="font-body text-bfc-brand-fg/60 text-sm mb-4">
        This product uses the TMDB API but is not endorsed or certified by TMDB.
      </p>
      <a
        href="https://www.themoviedb.org"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block shrink-0 opacity-70 hover:opacity-100 transition-opacity duration-300"
        aria-label="The Movie Database"
      >
        <TmdbLogo class="w-20 h-auto" />
      </a>
    </div>
  </div>
</footer>
