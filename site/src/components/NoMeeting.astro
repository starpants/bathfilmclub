---
import DiscordButton from './DiscordButton.astro';
---

<div class="festive">
<section class="bg-bfc-brand-alt/10 border-y-2 border-bfc-brand-fg/20">
  <div class="max-w-site mx-auto px-6 py-16 text-center space-y-4">
    <h2 class="font-heading font-extrabold text-4xl md:text-5xl">No meeting this month</h2>
    <p class="font-body text-bfc-brand-fg/80 text-xl">We'll be back in January.</p>
    <p class="font-body text-bfc-brand-fg/80 text-xl">Keep an eye on Discord for the new theme.</p>
    <div class="pt-4 flex justify-center">
      <DiscordButton />
    </div>
  </div>
</section>
</div>
